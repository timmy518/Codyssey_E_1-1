# 1) 볼륨 생성 / 목록 / 상세 정보 (Mountpoint = Docker 가 관리하는 실제 저장 위치)
timmy518@AISiLa:~$ docker volume create web-data
web-data

timmy518@AISiLa:~$ docker volume ls
DRIVER    VOLUME NAME
local     web-data

timmy518@AISiLa:~$ docker volume inspect web-data
[
    {
        "CreatedAt": "2026-11-02T14:50:51+09:00",
        "Driver": "local",
        "Labels": null,
        "Mountpoint": "/var/lib/docker/volumes/web-data/_data",
        "Name": "web-data",
        "Options": null,
        "Scope": "local"
    }
]

# 2) 볼륨을 /data 에 연결한 컨테이너에서 데이터 쓰기
timmy518@AISiLa:~$ docker run -d --name vol-writer -v web-data:/data ubuntu:24.04 sleep infinity
c272558aef411459b627ad3c9c732eb328c852e3647eac4e4a5777e4481fcb64

timmy518@AISiLa:~$ docker exec vol-writer sh -c 'echo "written by vol-writer at $(date +%F_%T)" > /data/note.txt && cat /data/note.txt'
written by vol-writer at 2026-11-02_05:50:51

# 3) 컨테이너 삭제 전/후 비교 — 컨테이너는 사라져도 볼륨은 남아 있다
timmy518@AISiLa:~$ docker ps -a --filter name=vol- --format "table {{.Names}}\t{{.Status}}\t{{.Mounts}}"
NAMES        STATUS                  MOUNTS
vol-writer   Up Less than a second   web-data

timmy518@AISiLa:~$ docker rm -f vol-writer
vol-writer

timmy518@AISiLa:~$ docker ps -a --filter name=vol- --format "table {{.Names}}\t{{.Status}}\t{{.Mounts}}"
NAMES     STATUS    MOUNTS

timmy518@AISiLa:~$ docker volume ls
DRIVER    VOLUME NAME
local     web-data

# 4) 새 컨테이너에 같은 볼륨을 연결 → 이전 컨테이너가 쓴 데이터가 그대로 있다
timmy518@AISiLa:~$ docker run -d --name vol-reader -v web-data:/data ubuntu:24.04 sleep infinity
edb1c5c803f3bcb4907328eacc2b70b1b9aaf826bb9f1235700ec776dbea5ae3

timmy518@AISiLa:~$ docker exec vol-reader cat /data/note.txt
written by vol-writer at 2026-11-02_05:50:51

timmy518@AISiLa:~$ docker exec vol-reader sh -c 'echo "appended by vol-reader" >> /data/note.txt && cat /data/note.txt'
written by vol-writer at 2026-11-02_05:50:51
appended by vol-reader

timmy518@AISiLa:~$ docker rm -f vol-reader
vol-reader

# 5) 비교 실험: 볼륨 없이 컨테이너 자신의 쓰기 층(writable layer)에만 쓴 데이터
timmy518@AISiLa:~$ docker run --name no-volume ubuntu:24.04 sh -c 'echo temp-data > /tmp/temp.txt && cat /tmp/temp.txt'
temp-data

#    멈춘(Exited) 컨테이너 안에는 아직 남아 있다 (docker diff: A = 추가된 파일, C = 바뀐 디렉토리)
timmy518@AISiLa:~$ docker diff no-volume
C /tmp
A /tmp/temp.txt

#    새 컨테이너는 이미지에서 빈 쓰기 층으로 시작하므로 보이지 않는다 (컨테이너끼리 공유되지 않음)
timmy518@AISiLa:~$ docker run --rm ubuntu:24.04 cat /tmp/temp.txt
cat: /tmp/temp.txt: No such file or directory
[exit code: 1]

#    컨테이너를 지우면 그 쓰기 층과 안의 데이터도 함께 삭제된다
timmy518@AISiLa:~$ docker rm no-volume
no-volume

timmy518@AISiLa:~$ docker diff no-volume
Error response from daemon: No such container: no-volume
[exit code: 1]

# 6) 볼륨 데이터는 볼륨이 남아 있는 한 언제든 다시 확인할 수 있다
timmy518@AISiLa:~$ docker run --rm -v web-data:/data ubuntu:24.04 ls -l /data
total 4
-rw-r--r-- 1 root root 68 Nov  2 05:50 note.txt

# 7) (보충, 11월 3일 14:39 KST) 볼륨 백업·복원 — 볼륨은 컨테이너가 바뀌어도 데이터가 남는 '영속성'일 뿐 백업이 아니다.
#    볼륨을 지우면(docker volume rm) 데이터도 사라지므로, 볼륨 내용을 tar 파일로 볼륨 밖(호스트 폴더)에 백업해 두고 새 볼륨에 복원한다.
#    증거용 web-data 볼륨과 실습 컨테이너는 건드리지 않고, 시험용 볼륨 backup-demo 로 확인했다.
timmy518@AISiLa:~/codyssey/practice$ docker volume create backup-demo
backup-demo

timmy518@AISiLa:~/codyssey/practice$ docker run --rm -v backup-demo:/data ubuntu:24.04 sh -c 'echo "backup test $(date +%F_%T)" > /data/note.txt && cat /data/note.txt && sha256sum /data/note.txt'
backup test 2026-11-03_05:39:05
22a43c0b4a4c249cc3bf9ba39e1a5b6377e96a3da105c594be936510ce772fdb  /data/note.txt

#    백업: 볼륨을 읽기 전용(:ro)으로, 호스트 폴더 volume-backup 을 /backup 으로 연결한 임시 컨테이너가 tar 로 묶는다
timmy518@AISiLa:~/codyssey/practice$ mkdir -p volume-backup

timmy518@AISiLa:~/codyssey/practice$ docker run --rm -v backup-demo:/data:ro -v "$PWD/volume-backup":/backup ubuntu:24.04 tar czf /backup/backup-demo.tgz -C /data .

timmy518@AISiLa:~/codyssey/practice$ ls -l volume-backup
total 4
-rw-r--r-- 1 root root 172 Nov  3 14:39 backup-demo.tgz

#    사고 재현: 볼륨을 지우면 그 안의 데이터도 함께 사라진다(목록에 backup-demo 가 없음)
timmy518@AISiLa:~/codyssey/practice$ docker volume rm backup-demo
backup-demo

timmy518@AISiLa:~/codyssey/practice$ docker volume ls --filter name=backup-demo
DRIVER    VOLUME NAME

#    복원: 새 볼륨을 만들고 백업 파일을 풀어 넣은 뒤, 내용과 sha256 해시가 백업 전과 같은지 확인
timmy518@AISiLa:~/codyssey/practice$ docker volume create backup-restore
backup-restore

timmy518@AISiLa:~/codyssey/practice$ docker run --rm -v backup-restore:/data -v "$PWD/volume-backup":/backup ubuntu:24.04 tar xzf /backup/backup-demo.tgz -C /data

timmy518@AISiLa:~/codyssey/practice$ docker run --rm -v backup-restore:/data:ro ubuntu:24.04 sh -c 'cat /data/note.txt && sha256sum /data/note.txt'
backup test 2026-11-03_05:39:05
22a43c0b4a4c249cc3bf9ba39e1a5b6377e96a3da105c594be936510ce772fdb  /data/note.txt

#    정리: 시험용 볼륨만 지운다(백업 파일 volume-backup/backup-demo.tgz 는 남김). 증거용 web-data 는 그대로다
timmy518@AISiLa:~/codyssey/practice$ docker volume rm backup-restore
backup-restore

timmy518@AISiLa:~/codyssey/practice$ docker volume ls
DRIVER    VOLUME NAME
local     web-data

