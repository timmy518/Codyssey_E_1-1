# 1) 포트 매핑 없이 실행 → 컨테이너는 80번에서 잘 돌고 있지만, 호스트의 localhost 로는 접속할 수 없다
timmy518@AISiLa:~/codyssey/dev-workstation$ docker run -d --name web-noport my-web:1.0
761bdf2c30eec1495656bbd98ba13b9435ef51c366e859632409928d88d53503

timmy518@AISiLa:~/codyssey/dev-workstation$ docker ps --filter name=web-noport --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
NAMES        STATUS                                     PORTS
web-noport   Up Less than a second (health: starting)   80/tcp

timmy518@AISiLa:~/codyssey/dev-workstation$ curl -sS --max-time 3 http://localhost:80
curl: (7) Failed to connect to localhost port 80 after 0 ms: Couldn't connect to server
[exit code: 7]

timmy518@AISiLa:~/codyssey/dev-workstation$ docker exec web-noport wget -qO- http://127.0.0.1/health
ok

#    컨테이너는 Docker 내부 네트워크(bridge)의 자기 IP 에서 듣고 있다. 리눅스 호스트(WSL) 안에서는 그 IP 로 직접 닿지만,
#    Windows 브라우저나 다른 PC 는 이 내부 IP 에 닿지 않는다 → -p 로 호스트 포트에 연결해야 한다
timmy518@AISiLa:~/codyssey/dev-workstation$ docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' web-noport
172.17.0.2

timmy518@AISiLa:~/codyssey/dev-workstation$ curl -sS --max-time 3 http://$(docker inspect -f "{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}" web-noport)/health
ok

timmy518@AISiLa:~/codyssey/dev-workstation$ docker rm -f web-noport
web-noport

# 2) -p <호스트포트>:<컨테이너포트> 로 실행 — 같은 이미지로 컨테이너 2개, 호스트 포트만 다르게
#    web-8081 은 -e APP_ENV=prod 로 환경 변수를 바꿔서 실행 (이미지를 다시 빌드하지 않고 동작 변경)
timmy518@AISiLa:~/codyssey/dev-workstation$ docker run -d --name web-8080 -p 8080:80 my-web:1.0
5a2248b15e0e76760e5e6292feb15473cf891c86d54f35c867ad3c4d07fc8275

timmy518@AISiLa:~/codyssey/dev-workstation$ docker run -d --name web-8081 -p 8081:80 -e APP_ENV=prod my-web:1.0
00466df6b603d3e452f76be91daffe19f4dba2b87125019326008988db225ee4

#    (헬스체크가 몇 번 돌 때까지 15초 대기)
timmy518@AISiLa:~/codyssey/dev-workstation$ docker ps --filter name=web-808 --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"
NAMES      IMAGE        STATUS                    PORTS
web-8081   my-web:1.0   Up 15 seconds (healthy)   0.0.0.0:8081->80/tcp, [::]:8081->80/tcp
web-8080   my-web:1.0   Up 15 seconds (healthy)   0.0.0.0:8080->80/tcp, [::]:8080->80/tcp

timmy518@AISiLa:~/codyssey/dev-workstation$ docker port web-8080
80/tcp -> 0.0.0.0:8080
80/tcp -> [::]:8080

timmy518@AISiLa:~/codyssey/dev-workstation$ docker port web-8081
80/tcp -> 0.0.0.0:8081
80/tcp -> [::]:8081

